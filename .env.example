# Copy this file to .env.local. Never commit real credentials here.
AI_GATEWAY_API_KEY=
# Optional alias for AI_GATEWAY_API_KEY:
VERCEL_AI_GATEWAY_KEY=
# Direct TypeSafe access is used only when no gateway key is configured.
JEV_API_KEY=
# Optional compatible upstream overrides:
# AI_GATEWAY_URL=https://ai-gateway.vercel.sh/typesafe/v1/systemone
# JEV_MODEL=typesafe-ai/jev
# Color-coded debug logs default to on in development, off in production.
# NEXT_PUBLIC_DEBUG_LOGS=false
